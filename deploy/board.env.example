# Store privately on Uno Q as /home/arduino/rgb-classifier/runtime.env, chmod 600.
SOURCE_ID=unoq
SOURCE_LOCATION=Home desk
ARCHIVE_URL=https://rgb.wehden.com
INGEST_TOKEN=replace-with-source-specific-private-runtime-token
CF_ACCESS_CLIENT_ID=replace-with-device-access-client-id
CF_ACCESS_CLIENT_SECRET=replace-with-device-access-client-secret
OUTBOX_DB=/data/outbox.sqlite3
INFERENCE_THREADS=2
MAX_FPS=0
